# The 108MB source archive stays out of git history — committing it is
# effectively irreversible without a history rewrite, and it is reproducible
# from the pinned Roboflow version recorded in model/class_map.yaml
# (roboflow-ngkro/shelf-product v1, sha256 d6378c1ce6d6…f8f1e9).
model/*.zip

# Node
node_modules/
.next/

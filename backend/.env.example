DATABASE_URL=postgresql+asyncpg://shelfeye:shelfeye@localhost:5433/shelfeye
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# "http" serves the trained model (docker compose --profile real-ml). "mock"
# returns detections chosen by FILENAME without looking at the image at all —
# it exists so the backend and its tests run without the ML service, and is
# not a fallback for a real deployment, because nothing it returns is a
# measurement.
ML_CLIENT=http
ML_SERVICE_URL=http://localhost:8001

# Generate your own — do NOT paste a value from this file or from git history.
# Anything ever committed to this repo is rejected at boot outside local/ci/demo:
#
#   openssl rand -hex 32
#
JWT_SECRET=

# local | ci | demo  → committed secrets and seeded demo accounts allowed
# uat | production   → both refused at boot (app/core/config.py, app/db/seed.py)
ENVIRONMENT=local

# Where the API lives. Every request in the app goes through
# src/lib/api/client.ts, which is the only file that reads this.
#
# Leave it unset for local development — the client already defaults to
# http://localhost:8000, which is where `make api` serves.
#
# Set it when the frontend and API are not on the same host: reaching the
# dev server from a phone over the LAN or a tunnel, for example, means the
# phone cannot resolve "localhost" and needs the machine's address.
#
#   NEXT_PUBLIC_API_URL=http://192.168.1.42:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo affordances: the screen-state switchers, the quick-login panel with its
# shared password, the platform launcher at /, and the phone frame on desktop.
#
# Unset (the default) is the build that ships to real users — those controls are
# eliminated from the bundle, not just hidden, so nobody can reach them from
# devtools. Set it to 1 only for a build that is going to be demonstrated.
#
#   NEXT_PUBLIC_DEMO_MODE=1
